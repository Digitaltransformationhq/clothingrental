# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
tests/.sessions/

# bundled database — 59MB of real rows, including credential hashes
/.pglite
# built at deploy time, 43MB, never committed
/.pglite-demo
/demo-database.tar.gz
/.pglite-*

# member uploads are written at runtime, not shipped with the repo
/public/uploads

# playwright output
/test-results/
/playwright-report/
